<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <title>StudyLoop</title>
    <!--[if mso]>
    <noscript>
      <xml>
        <o:OfficeDocumentSettings>
          <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
      </xml>
    </noscript>
    <![endif]-->
  </head>
  <body style="margin:0;padding:0;background-color:#faf6ee;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;">{{preheader}}</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#faf6ee;">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:480px;background-color:#ffffff;border:2px solid #1b1b18;border-radius:12px;">
            <tr>
              <td style="padding:32px 32px 4px;">
                <p style="margin:0;font-family:Georgia, 'Times New Roman', serif;font-style:italic;font-weight:700;font-size:22px;color:#1e4d3b;">StudyLoop</p>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 32px 0;">
                <p style="margin:0 0 12px;font-family:Georgia, 'Times New Roman', serif;font-style:italic;font-weight:700;font-size:20px;color:#1b1b18;">{{heading}}</p>
                {{#each paragraphs}}
                <p style="margin:0 0 16px;font-family:Arial, Helvetica, sans-serif;font-size:15px;line-height:1.6;color:#1b1b18;">{{this}}</p>
                {{/each}}
              </td>
            </tr>
            <tr>
              <td style="padding:8px 32px 32px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td bgcolor="#1e4d3b" style="border-radius:10px;">
                      <a href="{{ctaLink}}" target="_blank" style="display:inline-block;padding:12px 28px;font-family:Arial, Helvetica, sans-serif;font-size:14px;font-weight:bold;color:#faf6ee;text-decoration:none;border-radius:10px;">{{ctaText}}</a>
                    </td>
                  </tr>
                </table>
                <p style="margin:20px 0 0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.5;color:#55524a;">
                  If the button doesn't work, copy and paste this link into your browser:<br />
                  <a href="{{ctaLink}}" style="color:#1e4d3b;word-break:break-all;">{{ctaLink}}</a>
                </p>
                {{#if footnote}}
                <p style="margin:12px 0 0;font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:1.5;color:#55524a;">{{footnote}}</p>
                {{/if}}
              </td>
            </tr>
          </table>
          <p style="margin:20px 0 0;font-family:Arial, Helvetica, sans-serif;font-size:12px;color:#55524a;">StudyLoop</p>
        </td>
      </tr>
    </table>
  </body>
</html>
