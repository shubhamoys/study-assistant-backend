# ==========================================
# App
# ==========================================
NODE_ENV=development
PORT=4000
API_PREFIX=api

# Frontend origin(s) allowed to call this API (CORS), comma-separated.
# In dev, any http://192.168.*/10.*/172.16-31.* LAN origin is also allowed
# automatically (see main.ts) so a phone on the same Wi-Fi can reach the API
# without editing this on every DHCP IP change. :3001 is the admin panel
# (study-assistant-admin-frontend) — a separate origin from the main app.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Frontend origin used to build links inside emails (verify/reset password).
FRONTEND_URL=http://localhost:3000

# ==========================================
# Database (Postgres via docker-compose.yml)
# ==========================================
DATABASE_URL="postgresql://study_assistant:study_assistant@localhost:5433/study_assistant_dev"

# ==========================================
# Auth (Bearer access token + Bearer-returned refresh token)
# ==========================================
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=10

JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=30d

# ==========================================
# Rate limiting
# ==========================================
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ==========================================
# Seed data (src/database/seeds/seed.ts)
# Credentials for the seeded admin/system-author account — never hardcoded in
# the seeder itself. Dummy deck/flashcard content IS hardcoded in the seeder;
# only credentials and other sensitive values belong here.
# ==========================================
SEED_ADMIN_EMAIL=admin@studyloop.dev
SEED_ADMIN_PASSWORD=replace-with-a-dev-only-password

# Shared password for the two seeded demo-reviewer accounts (their emails are
# hardcoded in the seeder — dummy content, not sensitive — only the password
# lives here).
SEED_REVIEWER_PASSWORD=replace-with-a-dev-only-password

# ==========================================
# Local file storage (dev stand-in for Cloudflare R2 — see storage.config.ts)
# Path is relative to the backend project root; the folder is git-ignored.
# ==========================================
LOCAL_STORAGE_PATH=./uploads

# ==========================================
# Email (Mailtrap, dev) — verify/forgot/reset password flows
# ==========================================
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=
MAIL_FROM="StudyLoop <no-reply@studyloop.dev>"

# ==========================================
# Payments (Razorpay test mode) — Checkout, Orders, coupon-aware pricing
# Create a free account at https://dashboard.razorpay.com/ and use the Test
# Mode API keys (Settings → API Keys). Without real values here, checkout
# will fail once you reach the "Pay" step.
# ==========================================
RAZORPAY_API_KEY=rzp_test_replace-with-your-test-key-id
RAZORPAY_SECRET_KEY=replace-with-your-test-key-secret

# ==========================================
# Object storage (Cloudflare R2) — NOT used yet.
# Local disk (LOCAL_STORAGE_PATH above) is what every upload (avatars, deck
# covers, flashcard images) actually uses today; this is a placeholder for a
# future production swap and isn't read anywhere in the code yet. Leave blank.
# ==========================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
