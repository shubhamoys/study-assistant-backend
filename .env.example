# ==========================================
# App
# ==========================================
NODE_ENV=development
PORT=4000
API_PREFIX=api

# Frontend origin(s) allowed to call this API (CORS), comma-separated.
# In dev, any http://192.168.*/10.*/172.16-31.* LAN origin is also allowed
# automatically (see main.ts) so a phone on the same Wi-Fi can reach the API
# without editing this on every DHCP IP change.
CORS_ORIGIN=http://localhost:3000

# ==========================================
# Database (Postgres via docker-compose.yml)
# ==========================================
DATABASE_URL="postgresql://study_assistant:study_assistant@localhost:5433/study_assistant_dev"

# ==========================================
# Auth (Phase 1: access token only, Bearer header)
# ==========================================
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=10

# Phase 2 — refresh tokens (not used until Phase 2 starts)
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=30d

# ==========================================
# Rate limiting
# ==========================================
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ==========================================
# Seed data (src/database/seeds/seed.ts)
# Credentials for the seeded admin/system-author account — never hardcoded in
# the seeder itself. Dummy deck/flashcard content IS hardcoded in the seeder;
# only credentials and other sensitive values belong here.
# ==========================================
SEED_ADMIN_EMAIL=admin@studyassistant.dev
SEED_ADMIN_PASSWORD=replace-with-a-dev-only-password

# ==========================================
# Local file storage (dev stand-in for Cloudflare R2 — see storage.config.ts)
# Path is relative to the backend project root; the folder is git-ignored.
# ==========================================
LOCAL_STORAGE_PATH=./uploads

# ==========================================
# Phase 2 — Email (Mailtrap, dev)
# Not used until Phase 2 auth flows (verify/forgot/reset password) are built.
# ==========================================
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=
MAIL_FROM="AI Study Assistant <no-reply@studyassistant.dev>"

# ==========================================
# Phase 2 — Object storage (Cloudflare R2)
# Not used until the rich-text editor / attachment uploads are built.
# ==========================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
